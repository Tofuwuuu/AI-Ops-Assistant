# Application
APP_NAME=AI Ops Assistant
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM (pluggable: openai | anthropic | groq)
# Groq is free (no credit card) and OpenAI-compatible — get a key at https://console.groq.com/keys
LLM_PROVIDER=groq
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GROQ_API_KEY=gsk_your-groq-key-here
LLM_MODEL=llama-3.3-70b-versatile

# Database
DATABASE_URL=postgresql+psycopg://ops:ops@postgres:5432/ai_ops
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops
POSTGRES_DB=ai_ops

# Redis
REDIS_URL=redis://redis:6379/0
AGENT_QUEUE_KEY=agent:queue
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook/ops-assistant
N8N_WEBHOOK_SECRET=change-me-n8n-secret
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Knowledge base
KB_DOCS_PATH=/app/knowledge_base

# Auth
JWT_SECRET_KEY=change-me-jwt-secret-dev-only

# Email / SMS (optional — mock adapters used when unset)
SENDGRID_API_KEY=SG.your-sendgrid-key-here
TWILIO_ACCOUNT_SID=ACyour-twilio-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15555550100
CAMPAIGN_QUEUE_KEY=campaign:queue

# Stripe (optional — mock checkout used when unset)
STRIPE_SECRET_KEY=sk_test_your-stripe-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
FRONTEND_PUBLIC_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
