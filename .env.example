# Application
APP_NAME=AI Ops Assistant
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM (pluggable: openai | anthropic)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_MODEL=gpt-4o-mini

# Database
DATABASE_URL=postgresql+psycopg://ops:ops@postgres:5432/ai_ops
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops
POSTGRES_DB=ai_ops

# Redis
REDIS_URL=redis://redis:6379/0
AGENT_QUEUE_KEY=agent:queue
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook/ops-assistant
N8N_WEBHOOK_SECRET=change-me-n8n-secret
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Knowledge base
KB_DOCS_PATH=/app/knowledge_base

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
